# Copie para .env.local (ou cadastre na Vercel) e preencha. Nunca faça commit do .env.local.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave secreta (service_role): só no servidor. Todo acesso ao banco passa por ela.
SUPABASE_SERVICE_ROLE_KEY=

# E-mails que viram administrador ao entrar (separados por vírgula)
ADMIN_EMAILS=

# App do Meta "Alertas de Tráfego" > Configurações do app > Básico
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v23.0
# Só para app do Meta do tipo Empresa: ID da configuração do "Login do Facebook para Empresas"
META_CONFIG_ID=

# Senha que o agendador do Supabase manda para /api/verificar (de hora em hora). Longa e aleatória.
CRON_SECRET=
