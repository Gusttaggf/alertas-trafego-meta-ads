# Copie para .env.local e preencha. Nunca faça commit do .env.local.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave secreta (service_role): só no servidor. Usada para guardar o token do Meta.
SUPABASE_SERVICE_ROLE_KEY=

# App do Meta "Alertas de Tráfego" > Configurações do app > Básico
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v23.0
# Só se o app do Meta for do tipo Empresa e pedir "Login do Facebook para Empresas":
# ID da configuração de login (com token de usuário e a permissão ads_read).
NEXT_PUBLIC_META_CONFIG_ID=
